{
  "identifier": "com.chromatofoor.app",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Chromatofoor",
        "width": 1440,
        "height": 900,
        "decorations": false
      }
    ]
  }
}
